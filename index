<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Navegador Web Simples</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 0; padding: 20px; background-color: #f4f4f9; }
        #controls { display: flex; gap: 10px; margin-bottom: 20px; }
        input { flex: 1; padding: 10px; font-size: 16px; border: 1px solid #ddd; border-radius: 4px; }
        button { padding: 10px 20px; font-size: 16px; background-color: #0066cc; color: white; border: none; border-radius: 4px; cursor: pointer; }
        button:hover { background-color: #0055b3; }
        iframe { width: 100%; height: 500px; border: 1px solid #ddd; border-radius: 4px; background-color: white; }
    </style>
</head>
<body>

    <div id="controls">
        <input type="text" id="urlInput" placeholder="Digite a URL (ex: https://exemplo.com)" value="https://example.com">
        <button onclick="navegar()">Ir</button>
    </div>

    <iframe id="browserFrame" src="https://example.com"></iframe>

    <script>
        function navegar() {
            const url = document.getElementById('urlInput').value;
            document.getElementById('browserFrame').src = url;
        }
    </script>
</body>
</html>
